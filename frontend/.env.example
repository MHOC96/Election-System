# Local dev — Vite proxies /api to Django on :8000
VITE_API_URL=/api

# Production (Vercel) — BACKEND_URL is resolved into VITE_API_URL at build time.
# Set VITE_API_URL=/api (or remove a stale full URL). Do not point at *.vercel.app.
# BACKEND_URL=https://your-service.up.railway.app
# VITE_API_URL=/api

# Production alternative — call Railway directly (requires CORS on backend)
# VITE_API_URL=https://your-service.up.railway.app/api
