# Django — production SECRET_KEY must be 50+ random characters when DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string-at-least-fifty-characters-long
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production: Railway backend + Vercel frontend + Supabase database ---
# DEBUG=False
# ALLOWED_HOSTS is optional on Railway — RAILWAY_PUBLIC_DOMAIN is added automatically.
# For other hosts (custom domains), set ALLOWED_HOSTS explicitly.
# ALLOWED_HOSTS=your-service.up.railway.app
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
# SECURE_SSL_REDIRECT=True

# Supabase PostgreSQL (keep DB on Supabase — Railway only runs the Django API)
# Supabase → Project Settings → Database → Connection string → Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DB_POOL_MODE=transaction
# DB_SSLMODE=require   # optional; auto-enabled for remote hosts when DEBUG=False

# Session pooler (5432) — only with few Gunicorn workers (≤4) and a higher pool limit.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# DB_POOL_MODE=session
# DB_CONN_MAX_AGE=60
# DB_CONN_HEALTH_CHECKS=True

# CORS — must list your Vercel frontend URL(s), comma-separated, no spaces
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT lifetimes (minutes)
JWT_ACCESS_TOKEN_LIFETIME=30
JWT_REFRESH_TOKEN_LIFETIME=1440

# Redis — required when DEBUG=False (Railway Redis plugin or external)
REDIS_URL=redis://localhost:6379/0

# Cloudinary (candidate / application photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional
# LOG_LEVEL=INFO
# DB_SSLMODE=require
# DB_CONNECT_TIMEOUT=10
