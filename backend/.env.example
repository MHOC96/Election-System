# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Production example (set DEBUG=False and use strong values):
# DEBUG=False
# ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# SECURE_SSL_REDIRECT=True

# PostgreSQL — choose pooler by expected concurrency
#
# Transaction pooler (6543) — recommended for 50–150+ concurrent users on Supabase.
# Many HTTP requests share the same ~15 backend DB slots; Django uses CONN_MAX_AGE=0.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres
DB_POOL_MODE=transaction

# Session pooler (5432) — only when you have few Gunicorn workers (≤4) AND a higher pool limit.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.pooler.supabase.com:5432/postgres
# DB_POOL_MODE=session
# DB_CONN_MAX_AGE=60
# DB_CONN_HEALTH_CHECKS=True

# CORS — include every frontend origin (comma-separated, no spaces)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT lifetimes (minutes)
JWT_ACCESS_TOKEN_LIFETIME=30
JWT_REFRESH_TOKEN_LIFETIME=1440

# Redis — required when DEBUG=False (shared cache across workers)
REDIS_URL=redis://localhost:6379/0

# Cloudinary (candidate / application photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional
# LOG_LEVEL=INFO
# DB_SSLMODE=require
# DB_CONNECT_TIMEOUT=10
